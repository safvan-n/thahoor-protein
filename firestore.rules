rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the caller has verified admin custom claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Public read for products; creation, modification and deletion restricted strictly to admin
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Public read for categories; creation, modification and deletion restricted strictly to admin
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders:
    // - Authenticated users can place orders
    // - Customers can read/update their own orders
    // - Authorized Admins can read, update, and delete any orders
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && (request.auth.token.email == resource.data.customer.email || isAdmin());
      allow delete: if isAdmin();
    }

    // Drivers: Public read for checkout/delivery assignment; write restricted to admins
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: explicitly deny access to any unconfigured collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
